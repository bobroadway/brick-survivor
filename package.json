{
  "name": "brick-survivor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A desktop game built with Phaser, TypeScript, Vite, and Electron.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && electron-builder --win zip",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.bricksurvivor.game",
    "productName": "Brick Survivor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip"
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
